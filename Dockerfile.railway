# Dockerfile optimized for Railway deployment
# Multi-stage build for minimal image size

# Stage 1: Builder
FROM --platform=$BUILDPLATFORM rust:1.94-alpine AS builder

WORKDIR /app

# Install build dependencies (Alpine packages)
RUN apk add --no-cache \
    musl-dev \
    gcc \
    make \
    libressl-dev \
    pkgconfig \
    upx \
    perl

# Copy dependency files first for better caching
COPY Cargo.toml Cargo.lock ./

# Copy source code
COPY src ./src
COPY public ./public
COPY build.rs ./build.rs

# Build the application for musl target
RUN rustup target add x86_64-unknown-linux-musl && \
    cargo build --release --target x86_64-unknown-linux-musl

# Compress binary with UPX
RUN upx --lzma --best target/x86_64-unknown-linux-musl/release/websurfx || true

# Copy binary
RUN cp target/x86_64-unknown-linux-musl/release/websurfx /app/websurfx

# Stage 2: Runtime (Minimal image)
FROM --platform=$BUILDPLATFORM alpine:3.19

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates libssl3

# Copy binary from builder
COPY --from=builder /app/websurfx /usr/local/bin/websurfx

# Copy public assets
COPY --from=builder /app/public /app/public

# Create websurfx config directory and copy default config
RUN mkdir -p /etc/xdg/websurfx && \
    mkdir -p /opt/websurfx

# Copy websurfx folder with default config
COPY websurfx/ /etc/xdg/websurfx/

# Copy public to standard location
COPY --from=builder /app/public /opt/websurfx/public/

# Set environment variables for Railway
ENV PORT=8080
ENV BINDING_IP=0.0.0.0

# Expose port
EXPOSE ${PORT}

# Run websurfx
CMD ["websurfx"]
